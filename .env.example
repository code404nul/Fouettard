# Copier ce fichier en .env et le remplir. Le .env ne doit jamais être commité.

# --- Bot et GitLab (obligatoires) ---
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_PROJECT_ID=

# --- Module planning (facultatif : sans PLANNING_OWNER_ID, il est désactivé) ---
PLANNING_OWNER_ID=
# Liens secrets. Une source sans lien est simplement désactivée.
ZEUS_ICS_URL=
OUTLOOK_ICS_URL=
# Mails : sans ces trois lignes, la lecture des mails est désactivée.
# Préfère un mot de passe d'application s'il existe chez ton hébergeur.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# Facultatif : IMAP_PORT=993 et IMAP_FOLDER=INBOX
